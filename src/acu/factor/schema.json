{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cilang/acu/schemas/factor.schema.json",
  "title": "ACU Factor Definition",
  "description": "A complete Factor with 19 nodes (x, y, z and 0-9a-f) and resonance parameters. Any node may contain a nested Factor, creating fractal depth. Text fields follow the Three-Sentence Rule: definition (≤3 sentences), role (1 sentence), manifestation (≤5 short examples).",
  "type": "object",
  "required": ["namespace", "lineage", "label", "definition", "role", "manifestation", "nodes", "resonance"],
  "properties": {
    "namespace": {
      "type": "string",
      "pattern": "^(?:[A-Za-z][A-Za-z0-9]*)(?:/[A-Za-z][A-Za-z0-9]*)*$",
      "description": "Hierarchical path indicating Factor's position in the inheritance tree, written in CamelCase"
    },
    "lineage": {
      "type": "object",
      "required": ["parent", "depth", "invariants_inherited"],
      "properties": {
        "parent": {
          "oneOf": [{ "type": "null" }, { "type": "string", "format": "uri-reference" }]
        },
        "depth": { "type": "integer", "minimum": 0 },
        "invariants_inherited": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "constraint", "preservation_rule"],
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "knot_type",
                  "alexander_polynomial",
                  "winding_number",
                  "ternary_distribution",
                  "seifert_invariants",
                  "resonance_parameters"
                ]
              },
              "constraint": { "type": "string" },
              "preservation_rule": { "type": "string" }
            }
          }
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-([a-z]+)(?:\\.(0|[1-9]\\d*))?)?$",
      "default": "0.8.0"
    },
    "label": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
    "definition": { "type": "string", "maxLength": 500 },
    "role": { "type": "string", "maxLength": 150 },
    "manifestation": { "type": "string", "maxLength": 200 },
    "topology": {
      "type": "object",
      "description": "Optional override of the topological structure. Default is T(19,2) torus knot as defined in acu.protocol.core.ariadi.manifestation.default.",
      "properties": {
        "structure_type": {
          "type": "string",
          "enum": ["knot", "link", "braid"],
          "default": "knot"
        },
        "structure_name": { "type": "string" },
        "planar_diagram_ref": { "type": "string" },
        "crossing_mapping": {
          "type": "object",
          "patternProperties": {
            "^[0-9a-fxyz]$": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resonance": {
      "type": "object",
      "required": ["n", "m", "Q", "R", "phase"],
      "properties": {
        "n": { "type": "integer", "minimum": 0 },
        "m": { "type": "integer", "minimum": 0 },
        "Q": { "type": "integer" },
        "R": { "type": "integer" },
        "phase": {
          "type": "object",
          "required": ["argument", "real", "imaginary", "simplified"],
          "properties": {
            "argument": { "type": "number" },
            "real": { "type": "number" },
            "imaginary": { "type": "number" },
            "simplified": { "type": "string" }
          }
        },
        "chirality": {
          "type": "string",
          "enum": ["left", "right", "amphichiral"]
        }
      }
    },
    "nodes": {
      "type": "object",
      "minProperties": 19,
      "maxProperties": 19,
      "patternProperties": {
        "^[0-9a-fxyz]$": { "$ref": "#/definitions/cilangNode" }
      },
      "additionalProperties": false
    },
    "text_constraints": {
      "type": "object",
      "description": "Optional override of default text constraints for this Factor and its descendants. When present, applies to all nodes and sub-Factors unless they specify their own.",
      "properties": {
        "definition": {
          "type": "object",
          "description": "Constraints for the definition field",
          "properties": {
            "max_sentences": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "default": 1,
              "description": "Maximum number of sentences. 1 is preferred; 3 is absolute maximum."
            },
            "max_words": {
              "type": "integer",
              "minimum": 1,
              "default": 50,
              "description": "Maximum number of words. Soft limit to prevent verbosity."
            },
            "guidance": {
              "type": "string",
              "const": "State what the Factor IS. One crisp sentence. If elaboration is needed, use role and manifestation."
            }
          }
        },
        "role": {
          "type": "object",
          "description": "Constraints for the role field",
          "properties": {
            "max_sentences": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1,
              "default": 1,
              "description": "Exactly one sentence."
            },
            "max_words": {
              "type": "integer",
              "minimum": 1,
              "default": 25,
              "description": "Maximum number of words. Role should be a single, direct statement of function."
            },
            "guidance": {
              "type": "string",
              "const": "State what the Factor DOES. One sentence. Active voice. Begin with 'To'."
            }
          }
        },
        "manifestation": {
          "type": "object",
          "description": "Constraints for the manifestation field",
          "properties": {
            "max_examples": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 3,
              "description": "Maximum number of examples. 3 is typical; 5 is absolute maximum."
            },
            "max_words_per_example": {
              "type": "integer",
              "minimum": 1,
              "default": 10,
              "description": "Maximum words per example. Each example should be a short phrase, not a full sentence."
            },
            "guidance": {
              "type": "string",
              "const": "List concrete examples of how this Factor manifests. Use short phrases separated by semicolons. Let the examples do the showing."
            }
          }
        }
      },
      "default": {
        "definition": { "max_sentences": 1, "max_words": 50 },
        "role": { "max_sentences": 1, "max_words": 25 },
        "manifestation": {
          "max_examples": 3,
          "max_words_per_example": 10
        }
      }
    },
    "type_binding": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "enum": [0, 1, 2],
          "description": "0 = raw substrate (no semantic overlay, corresponds to acu.protocol.core.cilang nodes), 1 = typed interface (level 1 in type_system), 2 = concrete instance (level 2 in type_system)"
        },
        "implements": {
          "type": "array",
          "items": { "type": "string", "format": "uri-reference" }
        },
        "paradigm": {
          "type": "string",
          "enum": [
            "topology",
            "category_theory",
            "type_theory",
            "probability_theory",
            "quantum_theory",
            "domain_specific"
          ],
          "description": "Typing paradigm used. 'domain_specific' is for custom paradigms; MythOS is a pre‑defined instance of domain_specific."
        },
        "type_context": { "type": "object" }
      }
    },
    "reading_modes": {
      "type": "object",
      "properties": {
        "default_mode": {
          "type": "string",
          "enum": ["knot", "link", "braid"]
        },
        "components": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[0-9a-fxyz]$" }
          }
        },
        "strands": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[0-9a-fxyz]$" }
          }
        },
        "open_ends": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9a-fxyz]$" }
        }
      }
    }
  },
  "definitions": {
    "cilangNode": {
      "type": "object",
      "required": ["label", "definition", "role", "manifestation"],
      "properties": {
        "label": { "type": "string", "maxLength": 30 },
        "definition": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "maxLength": 150 },
        "manifestation": { "type": "string", "maxLength": 200 },
        "crossing_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 19,
          "description": "The crossing index in the planar diagram (1..19 for T(19,2)). Implicit nodes (x,y,z) should omit this field."
        },
        "type": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string" },
                "parameters": { "type": "array" },
                "constraints": { "type": "array" }
              }
            }
          ]
        },
        "value": {
          "type": ["string", "number", "boolean", "array", "object", "null"]
        },
        "phase_offset": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0
        },
        "sub_factor": {
          "type": "object",
          "properties": {
            "namespace": {
              "type": "string",
              "pattern": "^(?:[A-Za-z][A-Za-z0-9]*)(?:/[A-Za-z][A-Za-z0-9]*)*$"
            }
          },
          "required": ["namespace"],
          "additionalProperties": false
        },
        "text_constraints": { "$ref": "#/definitions/textConstraints" }
      }
    },
    "textConstraints": {
      "type": "object",
      "description": "Editorial constraints on text fields to ensure clarity and conciseness",
      "properties": {
        "definition": {
          "type": "object",
          "properties": {
            "max_sentences": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "description": "Maximum number of sentences. 1 is preferred; 3 is absolute maximum."
            },
            "max_words": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum number of words."
            }
          }
        },
        "role": {
          "type": "object",
          "properties": {
            "max_sentences": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1,
              "description": "Exactly one sentence."
            },
            "max_words": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum number of words."
            }
          }
        },
        "manifestation": {
          "type": "object",
          "properties": {
            "max_examples": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "Maximum number of examples."
            },
            "max_words_per_example": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum words per example."
            }
          }
        }
      }
    }
  }
}
