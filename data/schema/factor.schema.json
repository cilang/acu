{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cilang/acu/data/schema/factor.schema.json",
  "title": "ACU Factor Definition",
  "description": "A Factor is a class declaration over the fixed T(19,2) topological scaffold. Every Factor always has exactly 19 Cilang nodes; completeness requires every node to have non‑empty label, definition, role, and manifestation.",
  "type": "object",
  "properties": {
    "namespace": {
      "type": "string",
      "pattern": "^(?:[A-Z][A-Za-z0-9]*)(?:/[A-Z][A-Za-z0-9]*)*$",
      "description": "Fully qualified class path, PascalCase segments, e.g., 'Foundation/Terminology/Civilization'."
    },
    "import": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(?:[A-Z][A-Za-z0-9]*)(?:/[A-Z][A-Za-z0-9]*)*$" },
      "uniqueItems": true,
      "default": [],
      "description": "Other Factors (namespaces) this Factor depends on. The runtime MUST load all imported Factors to resolve references. This is NOT inheritance."
    },
    "extend": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(?:[A-Z][A-Za-z0-9]*)(?:/[A-Z][A-Za-z0-9]*)*$" },
      "uniqueItems": true,
      "default": [],
      "description": "Parent Factors from which this Factor inherits point constructors, path constructors, norms, and resonance constraints."
    },
    "label": {
      "type": "string",
      "pattern": "^[A-Z][a-zA-Z0-9]*$",
      "description": "PascalCase class name, unique within its namespace."
    },
    "role": { "type": "string", "description": "Active‑voice single‑sentence summary – what this Factor DOES." },
    "definition": { "type": "string", "description": "Declarative class docstring – what this Factor IS." },
    "manifestation": {
      "type": "string",
      "description": "Concrete example or canonical instance, using at least one named instance of each point and path constructor."
    },
    "cilang": {
      "type": "object",
      "minProperties": 19,
      "maxProperties": 19,
      "patternProperties": {
        "^[0-9a-fxyz]$": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "pattern": "^[A-Z][a-zA-Z0-9]*$",
              "description": "PascalCase semantic name for this Cilang node (register)."
            },
            "role": { "type": "string" },
            "definition": { "type": "string" },
            "manifestation": { "type": "string" },
            "value": {
              "type": "integer",
              "enum": [-1, 0, 1],
              "default": 0,
              "description": "Ternary state: -1 = Potential, 0 = Processing, +1 = Actualized."
            },
            "phase_offset": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "default": 0,
              "description": "Additional phase shift in units of π."
            }
          },
          "additionalProperties": false
        }
      },
      "unevaluatedProperties": false,
      "description": "The 19 register fields (x,y,z,0‑9a‑f). Each node always has label, role, definition, manifestation, ternary value, and phase offset. Empty strings are permitted when status is 'partial'."
    },
    "type_binding": {
      "$ref": "#/$defs/typeBinding",
      "description": "Type‑mode parameters, term‑level context, resonance, quantization, and usepong bindings."
    },
    "metadata": {
      "$ref": "#/$defs/metadata",
      "description": "Versioning, authorship, licensing, and lifecycle status."
    }
  },
  "required": ["namespace", "label", "definition", "role", "manifestation", "cilang", "type_binding", "metadata"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "metadata": { "properties": { "status": { "const": "complete" } } } } },
      "then": {
        "properties": {
          "cilang": {
            "patternProperties": {
              "^[0-9a-fxyz]$": {
                "required": ["label", "definition", "role", "manifestation"],
                "properties": {
                  "label": { "minLength": 1 },
                  "role": { "minLength": 1 },
                  "definition": { "minLength": 1 },
                  "manifestation": { "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "typeBinding": {
      "type": "object",
      "required": ["resonance", "quantization", "usepong"],
      "properties": {
        "parameters": {
          "type": "object",
          "description": "Type‑former parameters – constructor arguments (univalence, HITs, homotopy level, plus domain‑specific extensions).",
          "properties": {
            "univalence_axiom": { "type": "boolean" },
            "higher_inductives": { "type": "boolean" },
            "homotopy_level": {
              "type": "string",
              "enum": [
                "contractible",
                "mere_proposition",
                "set",
                "groupoid",
                "2‑groupoid",
                "3‑groupoid",
                "4‑groupoid",
                "infinity‑groupoid"
              ]
            },
            "constructor": {
              "type": "object",
              "description": "Domain‑specific HIT constructors – point constructors, path constructors, and invariant norms that define this Factor's internal structure.",
              "properties": {
                "point": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": { "type": "string", "pattern": "^[A-Z][a-zA-Z0-9]*$" },
                      "definition": { "type": "string" }
                    },
                    "required": ["label", "definition"],
                    "additionalProperties": true
                  }
                },
                "path": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": { "type": "string", "pattern": "^[A-Z][a-zA-Z0-9]*$" },
                      "definition": { "type": "string" }
                    },
                    "required": ["label", "definition"],
                    "additionalProperties": true
                  }
                },
                "norm": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true,
          "default": null
        },
        "context": {
          "type": "object",
          "description": "Term‑level instantiation – concrete values inhabiting the type (character traits, location details, specific resonance numbers, etc.).",
          "additionalProperties": true,
          "default": null
        },
        "resonance": { "$ref": "#/$defs/resonance" },
        "quantization": { "$ref": "#/$defs/quantization" },
        "usepong": { "$ref": "#/$defs/usepongBinding" }
      },
      "anyOf": [{ "required": ["parameters"] }, { "required": ["context"] }],
      "additionalProperties": false
    },
    "resonance": {
      "type": "object",
      "required": ["n", "m", "chirality"],
      "properties": {
        "n": { "type": "integer", "minimum": 0 },
        "m": { "type": "integer", "minimum": 0 },
        "chirality": { "type": "string", "enum": ["left", "right", "amphichiral"], "default": "right" },
        "q": { "type": "integer", "description": "Computed Q = 19ⁿ" },
        "r": { "type": "integer", "description": "Computed R = 2ᵐ" },
        "phase": {
          "type": "object",
          "properties": {
            "argument": { "type": "number" },
            "real": { "type": "number" },
            "imaginary": { "type": "number" },
            "simplified": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "quantization": {
      "type": "object",
      "properties": {
        "base": { "const": 19, "default": 19 },
        "formula": { "type": "string", "default": "19^n × 2^m" },
        "total_capacity": { "type": "string" }
      },
      "additionalProperties": false
    },
    "usepongBinding": {
      "type": "object",
      "required": ["stratum"],
      "properties": {
        "stratum": {
          "type": "string",
          "enum": [
            "cable",
            "binary",
            "mixed",
            "ternary",
            "paired",
            "quadratic",
            "pentameric",
            "hexameric",
            "chiral_pair",
            "hyperbolic_cable",
            "global"
          ]
        },
        "satellite_id": { "type": "string" },
        "stratum_description": {
          "type": "string",
          "description": "Human‑readable description of the chosen Useong stratum."
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["status", "version"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["partial", "complete", "stable", "frozen", "deprecated"],
          "default": "partial",
          "description": "Partial = Cilang nodes may have empty semantic fields; complete = all 19 nodes have non‑empty label, definition, role, and manifestation."
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
          "description": "Semantic version, e.g., '1.0.0'."
        },
        "license": { "type": "string", "description": "SPDX license identifier or custom license string." },
        "author": {
          "type": "object",
          "properties": { "name": { "type": "string" }, "email": { "type": "string" }, "url": { "type": "string" } },
          "additionalProperties": false
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of initial creation."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last modification."
        }
      },
      "additionalProperties": false
    }
  }
}
